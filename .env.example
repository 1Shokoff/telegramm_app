# ---- Telegram ----
# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Ваш числовой Telegram ID (узнать: @userinfobot). Можно несколько через запятую.
SELLER_IDS=111111111

# Поставщики: им приходит уведомление о новом заказе и видны только UDID.
# Необязательно — без этой строки роли просто нет.
SUPPLIER_IDS=

# Кто из команды проверяет бота: их заказы — тестовые. Уведомления продавца
# и поставщика о таком заказе получает только сам тестировщик, в списках
# заказ помечен 🧪. Несколько ID — через запятую. Необязательно.
TEST_IDS=

# Юзернейм для кнопки «Помощь» (без @). Если пусто — помощь идёт через бота.
SUPPORT_USERNAME=

# ---- Mini App ----
# Публичный HTTPS-адрес приложения. Должен совпадать с DOMAIN.
WEBAPP_URL=https://apps.example.com
# Домен для Caddy (без https://)
DOMAIN=apps.example.com
# Почта для Let's Encrypt (можно оставить пустой)
ACME_EMAIL=

# ---- Товар и оплата ----
# Обычная цена.
PRICE_RUB=3000
# Акция (необязательно). Пока она идёт, покупатель платит PROMO_PRICE_RUB, а в боте
# и витрине видна зачёркнутая обычная цена. PROMO_UNTIL — последний день акции
# включительно по Москве (30.11.2026): со следующего дня цена сама возвращается
# к PRICE_RUB. Без PROMO_UNTIL акция бессрочная. PROMO_LABEL — подпись скидки,
# без неё «Скидка 50%».
PROMO_PRICE_RUB=
PROMO_UNTIL=
PROMO_LABEL=
# Неоплаченный заказ, по которому столько дней ничего не происходит, отменяется
# сам; за сутки до этого бот напоминает покупателю об оплате. От 2, 0 — не отменять.
ORDER_TTL_DAYS=3
PRODUCT_TITLE=Доступ для iPhone
PRODUCT_SUBTITLE=Весь каталог приложений

# manual  — покупатель платит переводом и присылает чек, вы подтверждаете кнопкой
# platega — страница оплаты Platega (СБП, карта, SberPay), подтверждение само
# demo    — оплата имитируется, деньги не списываются (для теста воронки)
# stars   — инвойс в Telegram Stars (нужен PRICE_STARS)
# Переключать можно в любой момент: неоплаченные заказы переходят на новый способ.
PAYMENT_MODE=manual

# Platega — ключи из личного кабинета: «Настройки → Интеграция и API».
# Нужны для PAYMENT_MODE=platega. Не храните их нигде, кроме этого файла на сервере.
# В кабинете Platega в поле Callback URL укажите https://<ваш домен>/api/platega/callback
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# Реквизиты, которые увидит покупатель в режиме manual. \n — перенос строки.
PAYMENT_DETAILS=СБП: +7 900 000-00-00 (Банк)\nПолучатель: Иван И.\nВ комментарии укажите номер заказа.

# Сумма в звёздах для PAYMENT_MODE=stars
PRICE_STARS=0

# Префикс номеров заказов: NP-0001
ORDER_PREFIX=NP

# ---- Прочее ----
# Время жизни подписи initData, секунды
INIT_DATA_TTL=86400
# Локальная отладка без Telegram (НЕ включать на проде)
DEV_MODE=0
LOG_LEVEL=INFO

# Путь к файлу базы внутри контейнера (менять не нужно)
DB_PATH=/data/bot.sqlite3

# Папка со сборками .ipa внутри контейнера (менять не нужно).
# Сами файлы кладутся на сервере в ./files рядом с docker-compose.yml
# и называются <слаг>-<версия>.ipa, например sber-17.6.1.ipa
IPA_DIR=/app/files

# Прокси для связи с api.telegram.org — если хостинг её блокирует.
# Примеры: socks5://user:pass@1.2.3.4:1080 или http://user:pass@1.2.3.4:8080
# Спецсимволы в пароле нужно записать в процентной кодировке (@ -> %40).
TELEGRAM_PROXY=
