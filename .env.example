# ---- Telegram ----
# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Ваш числовой Telegram ID (узнать: @userinfobot). Можно несколько через запятую.
SELLER_IDS=111111111

# Юзернейм для кнопки «Помощь» (без @). Если пусто — помощь идёт через бота.
SUPPORT_USERNAME=

# ---- Mini App ----
# Публичный HTTPS-адрес приложения. Должен совпадать с DOMAIN.
WEBAPP_URL=https://apps.example.com
# Домен для Caddy (без https://)
DOMAIN=apps.example.com
# Почта для Let's Encrypt (можно оставить пустой)
ACME_EMAIL=

# ---- Товар и оплата ----
PRICE_RUB=3000
PRODUCT_TITLE=Доступ для iPhone
PRODUCT_SUBTITLE=Весь каталог приложений

# manual — покупатель платит переводом, вы подтверждаете кнопкой
# demo   — оплата имитируется, деньги не списываются (для теста воронки)
# stars  — инвойс в Telegram Stars (нужен PRICE_STARS)
PAYMENT_MODE=manual

# Реквизиты, которые увидит покупатель в режиме manual. \n — перенос строки.
PAYMENT_DETAILS=СБП: +7 900 000-00-00 (Банк)\nПолучатель: Иван И.\nВ комментарии укажите номер заказа.

# Сумма в звёздах для PAYMENT_MODE=stars
PRICE_STARS=0

# Префикс номеров заказов: NP-0001
ORDER_PREFIX=NP

# ---- Прочее ----
# Время жизни подписи initData, секунды
INIT_DATA_TTL=86400
# Локальная отладка без Telegram (НЕ включать на проде)
DEV_MODE=0
LOG_LEVEL=INFO

# Шаблон инструкции: продавец сможет отправить его одной кнопкой. \n — перенос строки.
INSTRUCTION_TEMPLATE=

# Путь к файлу базы внутри контейнера (менять не нужно)
DB_PATH=/data/bot.sqlite3

# Прокси для связи с api.telegram.org — если хостинг её блокирует.
# Примеры: socks5://user:pass@1.2.3.4:1080 или http://user:pass@1.2.3.4:8080
# Спецсимволы в пароле нужно записать в процентной кодировке (@ -> %40).
TELEGRAM_PROXY=
